# Copy this file to .env and fill in real values. Never commit .env.
# LLM endpoint (OpenAI-compatible). Aliases: FLASH_API_KEY / DEEPSEEK_API_KEY.
DS_FLASH_API_KEY=
DS_FLASH_MODEL=deepseek-v4-flash
DS_FLASH_BASE_URL=https://api.deepseek.com/v1

# Web search / extraction (multiple keys may be comma-separated).
TAVILY_API_KEYS=

# Optional: higher rate limits for these sources.
GITHUB_TOKEN=
STACKEXCHANGE_API_KEY=

# Optional operational limits.
LLM_DS_CONCURRENCY=80
EVIDENCE_INPUT_BUDGET_CHARS=32000
