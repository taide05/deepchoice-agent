# Copy this file to .env and fill in real values. Never commit .env.
# LLM endpoint (OpenAI-compatible). Aliases: FLASH_API_KEY / DEEPSEEK_API_KEY.
DS_FLASH_API_KEY=
DS_FLASH_MODEL=deepseek-v4-flash
DS_FLASH_BASE_URL=https://api.deepseek.com/v1

# Web search / extraction (multiple keys may be comma-separated).
TAVILY_API_KEYS=

# Optional: higher rate limits for these sources.
GITHUB_TOKEN=
STACKEXCHANGE_API_KEY=

# Optional operational limits.
LLM_DS_CONCURRENCY=80
EVIDENCE_INPUT_BUDGET_CHARS=32000

# Optional API protection (leave empty/0 for local single-user use).
DEEPCHOICE_API_KEY=
DEEPCHOICE_RATE_LIMIT_PER_MINUTE=0

# Checkpoint resume (off by default). When enabled, the server offers
# POST /research/{task_id}/resume and recovers interrupted tasks at startup.
RESUME_ENABLED=0
RESUME_MAX_ATTEMPTS=2
# Optional: override the startup-recovery grace period beyond a run's own limit.
# RESUME_RECOVERY_GRACE_S=30

# Shared deployment layout (recommended when the repo has several git worktrees):
# point every checkout at one config file and one data directory instead of
# copying .env/outputs into each worktree.
# DEEPCHOICE_ENV_FILE=D:\deepchoice-data\.env
# DEEPCHOICE_OUTPUT_DIR=D:\deepchoice-data\outputs

