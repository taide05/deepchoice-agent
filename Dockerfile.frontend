# 前端只有 streamlit + httpx，使用项目已验证的 Python 版本即可单阶段构建
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir "streamlit>=1.63.0,<2" "httpx>=0.27.0,<1"

COPY frontend/ /app/

ENV PYTHONUNBUFFERED=1

EXPOSE 8501

ENTRYPOINT ["streamlit", "run", "app.py"]
CMD ["--server.port", "8501", "--server.address", "0.0.0.0"]
